#!/usr/bin/env python3
"""List Mango outputs, or preview a layout until the shell sends 'keep' on stdin."""
import json
import os
from pathlib import Path
import re
import select
import signal
import subprocess
import sys
import tempfile

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'mango/monitors.conf'
TRANSFORMS = ('normal', '90', '180', '270', 'flipped', 'flipped-90', 'flipped-180', 'flipped-270')
MODE = re.compile(r'([1-9]\d*)x([1-9]\d*)@(\d+(?:\.\d+)?)')


def randr(*args):
    result = subprocess.run(['wlr-randr', *args], capture_output=True, text=True, timeout=5)
    if result.returncode:
        raise ValueError(result.stderr.strip() or 'Mango rejected the display settings.')
    return result.stdout


def config_text():
    try:
        return CONFIG.read_text()
    except FileNotFoundError:
        return ''


def parse_rule(line):
    assignment, sep, body = re.split(r'\s+#', line, maxsplit=1)[0].strip().partition('=')
    if sep and assignment.strip() == 'monitor_rule':
        fields = (field.partition(':') for field in body.strip('"').split(','))
        return {key.strip(): value.strip() for key, colon, value in fields if colon}
    return {}


def matches(rule, head):
    if not rule or any(rule[k] != head.get(k) for k in ('make', 'model', 'serial') if k in rule):
        return False
    try:
        return re.search(rule.get('name', ''), head['name']) is not None
    except re.error:
        # Mango also accepts PCRE patterns outside Python's regex syntax.
        return False


def mode_string(width, height, refresh):
    return f'{width}x{height}@{float(refresh):.3f}'.rstrip('0').rstrip('.')


def screens():
    rules = [parse_rule(line) for line in config_text().splitlines()]
    outputs = []
    for head in json.loads(randr('--json')):
        rule = next((r for r in rules if matches(r, head)), {})
        configured = f"{rule.get('width')}x{rule.get('height')}@{rule.get('refresh')}"
        match = MODE.fullmatch(configured)
        saved = mode_string(*match.groups()) if match else None
        custom = saved if rule.get('custom') == '1' else None
        modes = []
        current = preferred = None
        for m in head['modes']:
            mode = mode_string(m['width'], m['height'], m['refresh'])
            if mode not in modes:
                modes.append(mode)
            if m['current']:
                current = mode
            if m['preferred']:
                preferred = mode
        if custom and custom not in modes:
            modes.append(custom)
        elif saved and saved not in modes:
            # Mango accepts nominal rates such as 60 for an advertised 59.94 Hz.
            resolution, rate = saved.split('@')
            candidates = [m for m in modes if m.split('@')[0] == resolution]
            saved = min(candidates, key=lambda m: abs(float(m.split('@')[1]) - float(rate)), default=None)
        # Disabled outputs omit their layout. Use the saved rule when available.
        position = head.get('position') or {}
        scale = head.get('scale') or 1
        try:
            configured_scale = float(rule.get('scale', scale))
            if 'scale' not in head or abs(configured_scale - scale) < 1 / 256:
                scale = configured_scale
        except ValueError:
            pass  # A Mango variable may supply the scale. Use the compositor's value.
        def layout_value(key, fallback=0):
            value = rule.get(key, '')
            return int(value) if value.lstrip('-').isdigit() else fallback

        outputs.append({
            'name': head['name'], 'label': head.get('description') or head['name'],
            'make': head.get('make'), 'model': head.get('model'), 'serial': head.get('serial'),
            'modes': modes, 'mode': current or saved or preferred or next(iter(modes), 'preferred'),
            'customMode': custom, 'enabled': head['enabled'], 'scale': scale,
            'x': position.get('x', layout_value('x')), 'y': position.get('y', layout_value('y')),
            'transform': TRANSFORMS.index(head['transform']) if head.get('transform') else layout_value('rr'),
        })
    return outputs


def arguments(layout):
    args = []
    for s in layout:
        args.extend(['--output', s['name']])
        if not s['enabled']:
            args.append('--off')
            continue
        args.append('--on')
        if s['mode'] == 'preferred':
            args.append('--preferred')
        else:
            custom = s['mode'] == s['customMode'] or s['mode'] not in s['modes']
            args.extend(['--custom-mode' if custom else '--mode', s['mode'] + 'Hz'])
        args.extend(['--pos', f"{s['x']},{s['y']}", '--scale', str(s['scale']),
                     '--transform', TRANSFORMS[s['transform']]])
    return args


def save(layout):
    # Update exact connector rules in place. Keep offline monitors, hand-written
    # attributes (HDR, VRR, ICC, etc.) and comments in the managed file.
    lines = config_text().splitlines(keepends=True)
    for s in layout:
        # Mango connector names are PCRE patterns. '-' is literal outside a character class.
        name = '^' + re.escape(s['name']).replace(r'\-', '-') + '$'
        indices = [i for i, line in enumerate(lines) if matches(parse_rule(line), s)]
        rule = parse_rule(lines[indices[0]]) if indices else {}
        rule['name'] = name
        rule.update(x=s['x'], y=s['y'], scale=s['scale'], rr=s['transform'])
        if s['enabled']:
            rule.pop('disable', None)
        else:
            rule['disable'] = 1
        mode = MODE.fullmatch(s['mode'])
        if mode:
            rule.update(zip(('width', 'height', 'refresh'), mode.groups()))
            if s['mode'] == s['customMode'] or s['mode'] not in s['modes']:
                rule['custom'] = 1
            else:
                rule.pop('custom', None)
        line = 'monitor_rule=' + ','.join(f'{k}:{v}' for k, v in rule.items())
        # Mango uses the first match on connection and the last on config reload.
        # Leave shared rules in place for other outputs and override both matches.
        for i in dict.fromkeys(indices[:1] + indices[-1:]):
            previous = parse_rule(lines[i]).get('name')
            if previous in (s['name'], name):
                comment = re.search(r'([ \t]+#.*)', lines[i])
                lines[i] = line + (comment[1] if comment else '') + '\n'
        if not indices or parse_rule(lines[indices[-1]]).get('name') != name:
            if lines and not lines[-1].endswith('\n'):
                lines[-1] += '\n'
            lines.append(line + '\n')
        if indices and parse_rule(lines[indices[0]]).get('name') != name:
            lines.insert(indices[0], line + '\n')
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    out = tempfile.NamedTemporaryFile('w', dir=CONFIG.parent, delete=False)
    try:
        with out:
            out.writelines(lines)
        os.replace(out.name, CONFIG)
    finally:
        Path(out.name).unlink(missing_ok=True)


def trial(draft, original):
    before = screens()
    if before != original:
        raise ValueError('The displays changed. Select the mode again.')
    changed = [s for s, old in zip(draft, before, strict=True) if s != old]
    args = arguments(changed)
    randr('--dryrun', *args)
    kept = False
    try:
        randr(*args)
        print('ready', flush=True)
        if select.select([sys.stdin], [], [], 15)[0] and sys.stdin.readline().strip() == 'keep':
            save(changed)
            kept = True
    finally:
        # A timeout, Undo, a closed shell or a failed save restores the live layout.
        if not kept:
            restore(before, changed)


def restore(before, changed):
    connected = {head['name']: [mode_string(m['width'], m['height'], m['refresh']) for m in head['modes']]
                 for head in json.loads(randr('--json'))}
    names = {s['name'] for s in changed} & connected.keys()
    if names:
        # A custom mode may disappear from the advertised list as soon as it is replaced.
        layout = [dict(s, modes=connected[s['name']]) for s in before if s['name'] in names]
        randr(*arguments(layout))


def terminate(signum, frame):
    raise SystemExit(128 + signum)


if __name__ == '__main__':
    try:
        if sys.argv[1] == 'list':
            print(json.dumps(screens()))
        elif sys.argv[1] == 'trial':
            signal.signal(signal.SIGTERM, terminate)
            trial(json.loads(sys.argv[2]), json.loads(sys.argv[3]))
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        sys.exit(str(exc))
