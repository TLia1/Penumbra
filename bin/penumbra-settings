#!/usr/bin/env python3
"""Read, change and apply Penumbra's settings in ~/.config/penumbra/settings.conf.

The installer asks for them; the shell's Settings pages change them through this script, which
applies keyboard settings to MangoWM and idle timings to swayidle. install.sh runs `apply` after copying, so both stay in step.

  penumbra-settings get                  every setting, as JSON
  penumbra-settings set KEY=VALUE...     check, save and apply; nothing changes if one is wrong
  penumbra-settings check KEY=VALUE...   only check
  penumbra-settings apply [--no-restart] write swayidle.conf and apply everything
  penumbra-settings layouts              keyboard layouts and their variants, as JSON
  penumbra-settings export [FILE]        portable preferences (see export --help for opt-ins)
  penumbra-settings import FILE          preview changes; add --apply to commit them
"""
import argparse
import datetime
import hashlib
import fcntl
from contextlib import contextmanager
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
SETTINGS = CONFIG / 'penumbra' / 'settings.conf'
IDLE_CONFIG = CONFIG / 'penumbra' / 'swayidle.conf'
MANGO_SETTINGS = CONFIG / 'mango' / 'settings.conf'
XKB_RULES = Path('/usr/share/X11/xkb/rules/base.lst')

# The same keys, order and defaults as install.sh (SETTING_KEYS, detect_settings), which also
# detects the keyboard on a first install. Idle timings are minutes, or "never".
DEFAULTS = {
    'kb_layout': 'us', 'kb_variant': '', 'kb_options': '', 'scale': 'auto', 'numlock': 'on',
    'shell': 'fish', 'terminal': 'kitty', 'file_manager': 'io.github.lia.Files',
    'idle_dim': '9.5', 'idle_lock': '10', 'idle_screen_off': '11', 'idle_suspend': '30',
}
IDLE = re.compile(r'^(never|[0-9]+(\.[0-9]+)?)$')


def xkb_section(name):
    """{code: description} for a section of the XKB rules ("layout", "variant")."""
    found, section = {}, None
    try:
        lines = XKB_RULES.read_text().splitlines()
    except OSError:
        return None
    for line in lines:
        if line.startswith('!'):
            section = line[1:].strip()
        elif section == name and line.strip():
            code, _, description = line.strip().partition(' ')
            found.setdefault(code, description.strip())
    return found


def problem(key, value):
    """Why VALUE won't do for KEY, or None."""
    if key == 'kb_layout':
        if not re.fullmatch(r'[a-z0-9_]+(,[a-z0-9_]+)*', value):
            return "Layout should look like 'us' or 'us,fr'."
        known = xkb_section('layout')
        for layout in value.split(','):
            if known is not None and layout not in known:
                return f"Unknown keyboard layout '{layout}'."
    elif key == 'kb_variant':
        if not re.fullmatch(r'[A-Za-z0-9_,-]*', value):
            return f"Invalid layout variant '{value}'."
    elif key == 'kb_options':
        if not re.fullmatch(r'[A-Za-z0-9_,:+-]*', value):
            return f"Invalid keyboard options '{value}'."
    elif key == 'scale':
        if not re.fullmatch(r'auto|[0-9]+(\.[0-9]+)?', value):
            return "Scale should be 'auto' or a number such as 1.25."
    elif key == 'numlock':
        if value not in ('on', 'off'):
            return "Num Lock should be 'on' or 'off'."
    elif key == 'shell':
        if value not in ('fish', 'keep'):
            return "Login shell should be 'fish' or 'keep'."
    elif key in ('terminal', 'file_manager'):
        if not re.fullmatch(r'[A-Za-z0-9._-]+', value):
            return "Apps are named by their desktop file, such as kitty or org.kde.dolphin."
    elif key.startswith('idle_') and key in DEFAULTS:
        if not IDLE.fullmatch(value) or value != 'never' and float(value) <= 0:
            return 'Idle timings are minutes, such as 10 or 2.5, or never.'
    else:
        return f"Unknown setting '{key}'."
    return None


def load():
    values = dict(DEFAULTS)
    configured = set()
    try:
        for line in SETTINGS.read_text().splitlines():
            key, sep, value = line.partition('=')
            # A value edited by hand into something wrong keeps its default: these values end up
            # in the desktop and idle configurations.
            if sep and re.fullmatch(r'[a-z_]+', key) and key in DEFAULTS and not problem(key, value):
                values[key] = value
                configured.add(key)
    except OSError:
        pass
    if 'file_manager' not in configured:
        checker = Path(__file__).with_name('penumbra-files')
        if checker.is_file():
            values['file_manager'] = subprocess.check_output([checker, '--detect'], text=True).strip()
    return values


def save(values):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    lines = ['# Penumbra settings, written by install.sh and the shell\'s Settings pages.',
             '# Edit them, then run ./install.sh --user-only (or penumbra-settings apply) to apply.']
    lines += [f'{key}={values[key]}' for key in DEFAULTS]
    # Keep preferences from a newer compatible release when editing after a downgrade.
    if SETTINGS.exists():
        for line in SETTINGS.read_text().splitlines():
            key, sep, _ = line.partition('=')
            if sep and re.fullmatch(r'[a-z_]+', key) and key not in DEFAULTS:
                lines.append(line)
    replace_private(SETTINGS, '\n'.join(lines) + '\n')


def seconds(minutes):
    return None if minutes == 'never' else max(1, round(float(minutes) * 60))


def idle_config(values):
    """swayidle events for logind requests and the four configurable idle timeouts."""
    helper = '~/.local/bin/penumbra-idle'
    lines = [f'lock "{helper} lock"', f'before-sleep "{helper} lock"',
             f'after-resume "{helper} dpms on"']
    timeouts = {key: seconds(values[key]) for key in ('idle_dim', 'idle_lock', 'idle_screen_off', 'idle_suspend')}
    dim, lock = timeouts['idle_dim'], timeouts['idle_lock']
    if dim is not None and lock is not None and dim >= lock:
        timeouts['idle_dim'] = max(1, lock - 30 if lock >= 60 else lock // 2)
    for key, action, resume in [('idle_dim', 'dim', 'undim'), ('idle_lock', 'lock', None),
                                ('idle_screen_off', 'dpms off', 'dpms on'), ('idle_suspend', 'suspend', None)]:
        if timeouts[key] is not None:
            event = f'timeout {timeouts[key]} "{helper} {action}"'
            if resume:
                event += f' resume "{helper} {resume}"'
            lines.append(event)
    return '\n'.join(lines) + '\n'


def mango_settings(values):
    """~/.config/mango/settings.conf for MangoWM's keyboard, scale, tiling and default apps."""
    lines = [
        '# Written by penumbra-settings from ~/.config/penumbra/settings.conf and shell.json.',
        f'var=terminal,{values["terminal"]}',
        f'var=file_manager,{values["file_manager"]}',
        f'xkb_rules_layout={values["kb_layout"]}',
    ]
    if values['kb_variant']:
        lines.append(f'xkb_rules_variant={values["kb_variant"]}')
    if values['kb_options']:
        lines.append(f'xkb_rules_options={values["kb_options"]}')
    lines.append(f'numlock_on={1 if values["numlock"] == "on" else 0}')
    if values['scale'] != 'auto':
        lines.append(f'monitor_rule=name:.*,scale:{values["scale"]}')
    shell = {}
    try:
        loaded = json.loads((CONFIG / 'penumbra' / 'shell.json').read_text())
        if isinstance(loaded, dict):
            shell = loaded
    except (OSError, ValueError, TypeError):
        pass
    if shell.get('reducedMotion'):
        lines.append('animations=0')
    valid_layouts = (
        'dwindle', 'tile', 'scroller', 'center_tile', 'right_tile', 'grid', 'deck', 'monocle', 'fair',
        'vertical_scroller', 'vertical_tile', 'vertical_grid', 'vertical_deck', 'vertical_fair',
    )
    layout = shell.get('tilingLayout') if shell.get('tilingLayout') in valid_layouts else 'dwindle'
    try:
        mfact = min(0.9, max(0.2, float(shell.get('masterRatio', 0.55))))
    except (TypeError, ValueError):
        mfact = 0.55
    try:
        scroller_prop = min(1.0, max(0.2, float(shell.get('scrollerProportion', 0.8))))
    except (TypeError, ValueError):
        scroller_prop = 0.8
    smart_gaps = 1 if shell.get('smartGaps') else 0
    smart_split = 1 if shell.get('dwindleSmartSplit') else 0
    new_master = 0 if shell.get('newWindowMaster') is False else 1
    scroller_center = 1 if shell.get('scrollerCenter') else 0
    monocle_tab = 0 if shell.get('monocleTabBar') is False else 1
    deck_tab = 0 if shell.get('deckTabBar') is False else 1
    floating_snap = 0 if shell.get('floatingSnap') is False else 1
    sloppy_focus = 0 if shell.get('sloppyFocus') is False else 1
    warp_cursor = 1 if shell.get('warpCursor') else 0
    hotarea = 1 if shell.get('nativeHotarea') else 0
    lines += [
        f'smart_gaps={smart_gaps}',
        f'new_is_master={new_master}',
        f'default_master_factor={mfact:.2f}',
        f'dwindle_smart_split={smart_split}',
        f'scroller_default_proportion={scroller_prop:.2f}',
        f'scroller_focus_center={scroller_center}',
        f'scroller_prefer_center={scroller_center}',
        f'monocle_tab_mode={monocle_tab}',
        f'deck_tab_mode={deck_tab}',
        f'enable_floating_snap={floating_snap}',
        f'sloppy_focus={sloppy_focus}',
        f'warp_cursor={warp_cursor}',
        f'enable_hotarea={hotarea}',
        f'tag_rule=id:*,layout_name:{layout},master_factor:{mfact:.2f},scroller_default_proportion:{scroller_prop:.2f}',
    ]
    return '\n'.join(lines) + '\n'


def apply(values, changed=None, restart=True):
    """Apply the settings in CHANGED (every one when None) to the running desktop."""
    def touched(*keys):
        return changed is None or any(k in changed for k in keys)

    if touched('idle_dim', 'idle_lock', 'idle_screen_off', 'idle_suspend'):
        IDLE_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        IDLE_CONFIG.write_text(idle_config(values))
        if restart:
            subprocess.run(['systemctl', '--user', 'try-restart', 'penumbra-idle.service'], capture_output=True)
    if touched('kb_layout', 'kb_variant', 'kb_options', 'numlock', 'scale', 'terminal', 'file_manager'):
        MANGO_SETTINGS.parent.mkdir(parents=True, exist_ok=True)
        MANGO_SETTINGS.write_text(mango_settings(values))
        if os.environ.get('MANGO_INSTANCE_SIGNATURE') and shutil.which('mmsg'):
            subprocess.run(['mmsg', 'dispatch', 'reload_config'], capture_output=True)


STATE = Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state')
EXPORTED = {
    'settings.conf': SETTINGS,
    'shell.json': CONFIG / 'penumbra/shell.json',
    'theme.json': STATE / 'penumbra/theme.json',
    'corners': STATE / 'penumbra/corners',
    'monitors.conf': CONFIG / 'mango/monitors.conf',
}
# New shell fields need an explicit portability decision before they leave the machine.
PORTABLE = set("""
    animatedWallpapers stillWhenCovered stillOnBattery desktopClock desktopAura desktopMusic desktopLyricsOnline barStyle compactMonitor workspaceStyle
    osdPosition volumeBoost glassFrost weatherInBar screenFrame weatherEnabled dockMode dockPins hotCorner
    tilingLayout showAllTags smartGaps dwindleSmartSplit masterRatio newWindowMaster scrollerProportion
    scrollerCenter monocleTabBar deckTabBar floatingSnap sloppyFocus warpCursor nativeHotarea
    nightTemperature nightSchedule nightFrom nightTo nightOn castSound castPort reducedMotion textScale
    dndSchedule dndFrom dndTo dndWhileSharing dndFullscreen notificationSounds notificationRules
    clipboardDays recordMicrophone lockNotificationCount idleInhibitApps calendarWeekNumbers batteryLimit
""".split())


def json_object(text, name):
    value = json.loads(text)
    if not isinstance(value, dict):
        raise ValueError(f'{name} must contain a JSON object')
    return value


def preferences(name, text, options):
    if name == 'shell.json':
        obj = json_object(text, name)
        keys = PORTABLE.copy()
        if options.clipboard_pins:
            keys.add('clipboardPins')
        if options.location:
            keys.update(('weatherPlace', 'nightPlace'))
        selected = {key: obj[key] for key in sorted(keys & obj.keys())}
        if isinstance(obj.get('downloads'), dict):
            selected['downloads'] = {k: v for k, v in obj['downloads'].items()
                                     if k in ('kind', 'videoFormat', 'videoQuality', 'audioFormat', 'audioQuality')}
        return selected
    if name == 'theme.json':
        keys = {'mode', 'colors', 'hue', 'vividness', 'pick', 'harmonize', 'auto', 'preset'}
        return {k: v for k, v in json_object(text, name).items() if k in keys}
    if name == 'corners' and text.strip() not in ('sharp', 'rounded'):
        raise ValueError('corners must be sharp or rounded')
    if name == 'settings.conf':
        selected = {}
        for line in text.splitlines():
            key, sep, value = line.partition('=')
            if sep and key in DEFAULTS:
                error = problem(key, value)
                if error:
                    raise ValueError(error)
                selected[key] = value
        return selected
    return text


def formatted(name, value):
    if name == 'settings.conf':
        return ''.join(f'{k}={v}\n' for k, v in value.items())
    if name.endswith('.json'):
        return json.dumps(value, indent=2, ensure_ascii=False) + '\n'
    return value


@contextmanager
def settings_lock():
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    with (SETTINGS.parent / '.settings.lock').open('a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def replace_private(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, mode='w', delete=False) as f:
        tmp = Path(f.name)
        try:
            f.write(text)
            f.close()
            tmp.replace(path)
        finally:
            tmp.unlink(missing_ok=True)


def export(options):
    files = {}
    for name, path in EXPORTED.items():
        if name == 'monitors.conf' and not options.monitors:
            continue
        try:
            value = preferences(name, path.read_text(), options)
        except FileNotFoundError:
            continue
        files[name] = formatted(name, value)
    target = Path(options.file or Path.home() / f'penumbra-settings-{datetime.date.today()}.json').expanduser()
    replace_private(target, json.dumps({'penumbra': 2, 'files': files}, indent=2) + '\n')
    print(target)


def import_settings(options):
    data = json_object(Path(options.file).expanduser().read_text(), options.file)
    files = data.get('files')
    if data.get('penumbra') not in (1, 2) or not isinstance(files, dict):
        raise ValueError('not a Penumbra settings export')
    changes = {}
    summary = []
    for name, text in files.items():
        if name == 'monitors.lua' or (name == 'monitors.conf' and not options.monitors):
            continue
        if name not in EXPORTED or not isinstance(text, str):
            raise ValueError(f'invalid export entry {name!r}')
        path = EXPORTED[name]
        try:
            before = path.read_text()
        except FileNotFoundError:
            before = None
        incoming = preferences(name, text, options)
        if name in ('corners', 'monitors.conf'):
            if name == 'monitors.conf' and any(line.strip() and not line.lstrip().startswith(('#', 'monitor_rule='))
                   for line in incoming.splitlines()):
                raise ValueError('monitors.conf must contain only monitor rules')
            after, keys = incoming, []
        else:
            if name == 'settings.conf':
                current = preferences(name, before or '', options)
            else:
                current = json_object(before, name) if before is not None else {}
            if name == 'shell.json' and 'downloads' in incoming:
                local = current.get('downloads')
                incoming['downloads'] = {**(local if isinstance(local, dict) else {}), **incoming['downloads']}
            keys = [key for key, value in incoming.items() if key not in current or value != current[key]]
            if not keys:
                continue
            after = formatted(name, {**current, **incoming})
        if before != after:
            changes[path] = (before, after)
            action = 'Create' if before is None else 'Update'
            detail = ' (' + ', '.join(sorted(keys)) + ')' if keys else ''
            summary.append(f'{action} {path}{detail}')
    # Bind the shell's Apply button to both the export and the destination state it previewed.
    token = hashlib.sha256(json.dumps([(str(p), v) for p, v in changes.items()]).encode()).hexdigest()
    if options.reviewed and options.reviewed != token:
        raise ValueError('Settings changed since the preview. Preview the import again.')
    if options.json_preview:
        print(json.dumps({'summary': '\n'.join(summary) or 'No changes.', 'token': token if changes else ''}))
        return
    if summary:
        print('\n'.join(summary))
    if not changes:
        print('No changes.')
        return
    if not options.apply:
        print('Preview only. Use --apply to import.')
        return
    written = []
    try:
        for path, (before, after) in changes.items():
            if before is not None:
                replace_private(path.with_name(path.name + '.bak'), before)
            replace_private(path, after)
            written.append(path)
    except OSError:
        for path in reversed(written):
            before, _ = changes[path]
            if before is None:
                path.unlink()
            else:
                replace_private(path, before)
        raise
    if any(EXPORTED[n] in changes for n in ('settings.conf', 'shell.json', 'monitors.conf')):
        apply(load())
    for name, helper in [('theme.json', 'penumbra-theme'), ('corners', 'penumbra-corners')]:
        command = Path.home() / '.local/bin' / helper
        if EXPORTED[name] in changes and command.exists():
            subprocess.run([command, 'restore'], check=True)
    print('Import complete.')


def transfer(command, args):
    parser = argparse.ArgumentParser(prog='penumbra-settings ' + command)
    parser.add_argument('file', nargs='?' if command == 'export' else None)
    parser.add_argument('--clipboard-pins', action='store_true', help='include pinned clipboard text')
    parser.add_argument('--location', action='store_true', help='include weather and night light locations')
    parser.add_argument('--monitors', action='store_true', help='include this machine’s monitor layout')
    if command == 'import':
        parser.add_argument('--reviewed', help=argparse.SUPPRESS)
        parser.add_argument('--json-preview', action='store_true', help=argparse.SUPPRESS)
        parser.add_argument('--apply', action='store_true', help='apply the listed changes')
    options = parser.parse_args(args)
    try:
        if command == 'export':
            export(options)
        elif options.apply:
            with settings_lock():
                import_settings(options)
        else:
            import_settings(options)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f'penumbra-settings: {error}')


def parse(pairs):
    updates = {}
    for pair in pairs:
        key, sep, value = pair.partition('=')
        if not sep:
            sys.exit(f'penumbra-settings: expected KEY=VALUE, got {pair!r}')
        updates[key] = value.strip()
    errors = [p for p in (problem(k, v) for k, v in updates.items()) if p]
    if errors:
        print('\n'.join(errors), file=sys.stderr)
        sys.exit(2)
    return updates


def main():
    command, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ('', [])
    if command == 'get':
        print(json.dumps(load()))
    elif command == 'check':
        parse(args)
    elif command == 'set':
        updates = parse(args)
        with settings_lock():
            values = load()
            changed = {k for k, v in updates.items() if values[k] != v}
            values.update(updates)
            save(values)
            apply(values, changed)
    elif command == 'apply':
        apply(load(), restart='--no-restart' not in args)
    elif command in ('export', 'import'):
        transfer(command, args)
    elif command == 'layouts':
        layouts = xkb_section('layout') or {}
        variants = {}
        try:
            section = None
            for line in XKB_RULES.read_text().splitlines():
                if line.startswith('!'):
                    section = line[1:].strip()
                elif section == 'variant' and line.strip():
                    code, _, rest = line.strip().partition(' ')
                    layout, _, description = rest.strip().partition(':')
                    variants.setdefault(layout, []).append([code, description.strip()])
        except OSError:
            pass
        print(json.dumps({'layouts': sorted(layouts.items(), key=lambda l: l[1]), 'variants': variants}))
    else:
        sys.exit(__doc__.strip())


if __name__ == '__main__':
    main()
