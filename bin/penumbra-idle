#!/usr/bin/env bash
# Idle steps swayidle runs: dim the backlight before locking and bring it back, and suspend
# only while running on battery (desktops and laptops on the charger stay awake).
set -uo pipefail
fallback_lock() {
    local image=$HOME/.local/share/penumbra/lock.png
    local args=()
    [[ -r $image ]] && args=(-i "$image")
    swaylock "${args[@]}" "$@"
}
case ${1:-} in
    lock)
        ipc=$HOME/.local/bin/penumbra-ipc
        if "$ipc" lock lock >/dev/null; then
            # Hold swayidle's sleep inhibitor until the compositor acknowledges the lock.
            for _ in {1..20}; do
                "$ipc" lock isSecure >/dev/null && exit 0
                sleep 0.05
            done
        fi
        fallback_lock -f
        exit $?
        ;;
    fallback-lock)
        fallback_lock
        exit $?
        ;;
    dim)
        # Down to a third of the current level; brightnessctl remembers it for undim.
        current=$(brightnessctl --class=backlight get 2>/dev/null) || exit 0
        brightnessctl --class=backlight --save set $(( current / 3 > 0 ? current / 3 : 1 )) >/dev/null
        ;;
    undim)
        brightnessctl --class=backlight --restore >/dev/null 2>&1 || true
        ;;
    suspend)
        # A charger that is plugged in, or no battery at all, keeps the machine awake.
        battery=0
        for supply in /sys/class/power_supply/*; do
            [[ -r $supply/type ]] || continue
            case $(<"$supply/type") in
                Mains|USB) [[ $(cat "$supply/online" 2>/dev/null) == 1 ]] && exit 0 ;;
                Battery) [[ $(cat "$supply/scope" 2>/dev/null) == Device ]] || battery=1 ;;
            esac
        done
        (( battery )) && systemctl suspend
        ;;
    dpms)
        case ${2:-} in
            on)
                if [[ -n ${MANGO_INSTANCE_SIGNATURE:-} ]]; then
                    mmsg dispatch 'wakeup_monitor,.*' >/dev/null 2>&1 || true
                fi
                ;;
            off)
                if [[ -n ${MANGO_INSTANCE_SIGNATURE:-} ]]; then
                    mmsg dispatch 'sleep_monitor,.*' >/dev/null 2>&1 || true
                fi
                ;;
            *)
                echo 'Usage: penumbra-idle lock|dim|undim|suspend|dpms on|off' >&2
                exit 1
                ;;
        esac
        ;;
    *)
        echo 'Usage: penumbra-idle lock|dim|undim|suspend|dpms on|off' >&2
        exit 1
        ;;
esac
exit 0
