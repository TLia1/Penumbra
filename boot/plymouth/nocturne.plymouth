[Plymouth Theme]
Name=Nocturne
Description=A quieter orbit. Original violet orbital animation and native password dialogs.
ModuleName=two-step

[two-step]
Font=Sans 12
TitleFont=Sans 24
MonospaceFont=monospace 12
ImageDir=/usr/share/plymouth/themes/nocturne
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.38
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.38
HorizontalAlignment=.5
VerticalAlignment=.55
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.85
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0d0a12
BackgroundEndColor=0x0d0a12
ProgressBarBackgroundColor=0x352348
ProgressBarForegroundColor=0xb69af7
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
UseProgressBar=true
ProgressBarShowPercentComplete=true
Title=Installing updates
SubTitle=Do not turn off your computer
