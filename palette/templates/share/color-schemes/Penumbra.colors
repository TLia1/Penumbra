# PENUMBRA colours for KDE and Qt apps. Generated by tools/build-palette.py from palette/palette.toml; do not edit.
[General]
Name=Penumbra
ColorScheme=Penumbra
font=Inter,10,-1,5,50,0,0,0,0,0
fixed=JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0

