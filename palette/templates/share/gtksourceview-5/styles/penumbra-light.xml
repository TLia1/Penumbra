<?xml version="1.0" encoding="UTF-8"?>
<!-- PENUMBRA GtkSourceView colours. Generated by tools/build-palette.py; do not edit. -->
<style-scheme id="penumbra-light" name="Penumbra Light" version="1.0">
  <author>Lia</author>
  <description>Penumbra light syntax colours</description>
  <metadata><property name="variant">light</property><property name="dark-variant">penumbra</property></metadata>
  <style name="text" foreground="{{light.text}}" background="{{light.base}}"/>
  <style name="selection" foreground="{{light.selectionText}}" background="{{light.textSelection}}"/>
  <style name="cursor" foreground="{{light.accent}}"/>
  <style name="current-line" background="{{light.raised}}"/>
  <style name="line-numbers" foreground="{{light.muted}}" background="{{light.base}}"/>
  <style name="right-margin" foreground="{{light.border}}" background="{{light.base}}"/>
  <style name="search-match" foreground="{{light.base}}" background="{{light.amber}}"/>
  <style name="def:comment" foreground="{{light.dim}}" italic="true"/>
  <style name="def:string" foreground="{{light.green}}"/>
  <style name="def:character" foreground="{{light.green}}"/>
  <style name="def:constant" foreground="{{light.amber}}"/>
  <style name="def:number" foreground="{{light.amber}}"/>
  <style name="def:keyword" foreground="{{light.accent}}"/>
  <style name="def:statement" foreground="{{light.accent}}"/>
  <style name="def:type" foreground="{{light.cyan}}"/>
  <style name="def:function" foreground="{{light.blue}}"/>
  <style name="def:identifier" foreground="{{light.text}}"/>
  <style name="def:preprocessor" foreground="{{light.pink}}"/>
  <style name="def:special-char" foreground="{{light.rose}}"/>
  <style name="def:error" foreground="{{light.rose}}"/>
  <style name="def:note" foreground="{{light.amber}}"/>
</style-scheme>
