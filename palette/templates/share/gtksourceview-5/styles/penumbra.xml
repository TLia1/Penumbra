<?xml version="1.0" encoding="UTF-8"?>
<!-- PENUMBRA GtkSourceView colours. Generated by tools/build-palette.py; do not edit. -->
<style-scheme id="penumbra" name="Penumbra" version="1.0">
  <author>Lia</author>
  <description>Penumbra dark syntax colours</description>
  <metadata><property name="variant">dark</property><property name="light-variant">penumbra-light</property></metadata>
  <style name="text" foreground="{{dark.text}}" background="{{dark.base}}"/>
  <style name="selection" foreground="{{dark.selectionText}}" background="{{dark.textSelection}}"/>
  <style name="cursor" foreground="{{dark.accent}}"/>
  <style name="current-line" background="{{dark.raised}}"/>
  <style name="line-numbers" foreground="{{dark.muted}}" background="{{dark.base}}"/>
  <style name="right-margin" foreground="{{dark.border}}" background="{{dark.base}}"/>
  <style name="search-match" foreground="{{dark.base}}" background="{{dark.amber}}"/>
  <style name="def:comment" foreground="{{dark.dim}}" italic="true"/>
  <style name="def:string" foreground="{{dark.green}}"/>
  <style name="def:character" foreground="{{dark.green}}"/>
  <style name="def:constant" foreground="{{dark.amber}}"/>
  <style name="def:number" foreground="{{dark.amber}}"/>
  <style name="def:keyword" foreground="{{dark.accent}}"/>
  <style name="def:statement" foreground="{{dark.accent}}"/>
  <style name="def:type" foreground="{{dark.cyan}}"/>
  <style name="def:function" foreground="{{dark.blue}}"/>
  <style name="def:identifier" foreground="{{dark.text}}"/>
  <style name="def:preprocessor" foreground="{{dark.pink}}"/>
  <style name="def:special-char" foreground="{{dark.rose}}"/>
  <style name="def:error" foreground="{{dark.rose}}"/>
  <style name="def:note" foreground="{{dark.amber}}"/>
</style-scheme>
