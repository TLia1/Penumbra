# PENUMBRA colours for zathura. Generated by tools/build-palette.py from palette/palette.toml; do not edit.
# ./install.sh adds "include penumbra-colors" to your zathurarc.
set default-bg "{{base}}"
set default-fg "{{text}}"
set statusbar-bg "{{surface}}"
set statusbar-fg "{{textSoft}}"
set inputbar-bg "{{surface}}"
set inputbar-fg "{{text}}"
set notification-bg "{{surface}}"
set notification-fg "{{text}}"
set notification-error-bg "{{surface}}"
set notification-error-fg "{{rose}}"
set notification-warning-bg "{{surface}}"
set notification-warning-fg "{{amber}}"
set completion-bg "{{surface}}"
set completion-fg "{{textSoft}}"
set completion-group-bg "{{surfaceAlt}}"
set completion-group-fg "{{accent}}"
set completion-highlight-bg "{{hover}}"
set completion-highlight-fg "{{white}}"
set index-bg "{{surface}}"
set index-fg "{{textSoft}}"
set index-active-bg "{{hover}}"
set index-active-fg "{{white}}"
set highlight-color "rgba({{amber:rgb}},0.35)"
set highlight-fg "{{onAccent}}"
set highlight-active-color "rgba({{accent:rgb}},0.45)"
set render-loading-bg "{{base}}"
set render-loading-fg "{{muted}}"
# Ctrl+R: dark pages in the palette's colours.
set recolor-lightcolor "{{base}}"
set recolor-darkcolor "{{text}}"
set recolor-keephue true
