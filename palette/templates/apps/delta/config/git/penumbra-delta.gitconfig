# PENUMBRA colours for delta. Generated by tools/build-palette.py from palette/palette.toml; do not edit.
# ./install.sh includes this file from your Git configuration and adds "penumbra" to delta.features.
[delta "penumbra"]
    {{mode}} = true
    file-style = "{{accent}}" bold
    file-decoration-style = "{{border}}" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "{{border}}" box
    hunk-header-file-style = "{{accent}}"
    hunk-header-line-number-style = "{{muted}}"
    minus-style = syntax "{{diffDelete}}"
    minus-non-emph-style = syntax "{{diffDelete}}"
    minus-emph-style = syntax "{{diffDeleteEmph}}"
    minus-empty-line-marker-style = normal "{{diffDelete}}"
    plus-style = syntax "{{diffAdd}}"
    plus-non-emph-style = syntax "{{diffAdd}}"
    plus-emph-style = syntax "{{diffAddEmph}}"
    plus-empty-line-marker-style = normal "{{diffAdd}}"
    zero-style = syntax
    line-numbers-minus-style = "{{rose}}"
    line-numbers-plus-style = "{{green}}"
    line-numbers-zero-style = "{{dim}}"
    line-numbers-left-style = "{{border}}"
    line-numbers-right-style = "{{border}}"
    commit-style = "{{amber}}"
    commit-decoration-style = "{{border}}" box
    blame-palette = "{{base}} {{surface}} {{surfaceAlt}}"
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = "{{amber}}" bold
    merge-conflict-theirs-diff-header-style = "{{accent}}" bold
    whitespace-error-style = "{{rose}}" reverse
