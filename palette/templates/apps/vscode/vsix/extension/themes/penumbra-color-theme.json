  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{dim}}", "fontStyle": "italic" } },
    { "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "{{green}}" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "{{pink}}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "constant.character"], "settings": { "foreground": "{{amber}}" } },
    { "scope": ["support.constant"], "settings": { "foreground": "{{amber}}", "fontStyle": "italic" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "{{text}}" } },
    { "scope": ["variable.language"], "settings": { "foreground": "{{pink}}", "fontStyle": "italic" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "{{textSoft}}" } },
    { "scope": ["variable.other.member", "variable.other.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "{{textSoft}}" } },
    { "scope": ["keyword", "keyword.control", "storage.modifier", "storage.type"], "settings": { "foreground": "{{violet}}" } },
    { "scope": ["storage.type.function", "keyword.declaration.function"], "settings": { "foreground": "{{violet}}", "fontStyle": "italic" } },
    { "scope": ["keyword.control.import", "keyword.other.import", "keyword.control.include"], "settings": { "foreground": "{{pink}}" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "{{pink}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "{{amber}}" } },
    { "scope": ["storage.type.primitive", "support.type.primitive", "support.type.builtin"], "settings": { "foreground": "{{amber}}", "fontStyle": "italic" } },
    { "scope": ["entity.name.function", "meta.function-call", "variable.function", "support.function"], "settings": { "foreground": "{{blue}}" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.module"], "settings": { "foreground": "{{cyan}}" } },
    { "scope": ["entity.other.attribute-name", "meta.decorator", "meta.annotation", "entity.name.label"], "settings": { "foreground": "{{cyan}}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{violet}}" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.definition.tag"], "settings": { "foreground": "{{muted}}" } },
    { "scope": ["punctuation.section.embedded", "punctuation.definition.template-expression"], "settings": { "foreground": "{{pink}}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{violet}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{blue}}", "fontStyle": "underline" } },
    { "scope": ["markup.raw", "markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "{{green}}" } },
    { "scope": ["markup.list punctuation.definition.list", "punctuation.definition.list.begin"], "settings": { "foreground": "{{pink}}" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "{{muted}}", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{green}}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{rose}}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{violet}}" } },
    { "scope": ["invalid"], "settings": { "foreground": "{{rose}}" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "{{amber}}", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "namespace": "{{cyan}}",
    "parameter": "{{textSoft}}",
    "property": "{{textSoft}}",
    "enumMember": "{{amber}}",
    "macro": "{{amber}}",
    "*.defaultLibrary": { "fontStyle": "italic" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
