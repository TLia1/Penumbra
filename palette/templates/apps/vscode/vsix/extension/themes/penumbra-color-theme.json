  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{dark.dim}}", "fontStyle": "italic" } },
    { "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "{{dark.green}}" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "{{dark.pink}}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "constant.character"], "settings": { "foreground": "{{dark.amber}}" } },
    { "scope": ["support.constant"], "settings": { "foreground": "{{dark.amber}}", "fontStyle": "italic" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "{{dark.text}}" } },
    { "scope": ["variable.language"], "settings": { "foreground": "{{dark.pink}}", "fontStyle": "italic" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "{{dark.textSoft}}" } },
    { "scope": ["variable.other.member", "variable.other.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "{{dark.textSoft}}" } },
    { "scope": ["keyword", "keyword.control", "storage.modifier", "storage.type"], "settings": { "foreground": "{{dark.accent}}" } },
    { "scope": ["storage.type.function", "keyword.declaration.function"], "settings": { "foreground": "{{dark.accent}}", "fontStyle": "italic" } },
    { "scope": ["keyword.control.import", "keyword.other.import", "keyword.control.include"], "settings": { "foreground": "{{dark.pink}}" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "{{dark.pink}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "{{dark.amber}}" } },
    { "scope": ["storage.type.primitive", "support.type.primitive", "support.type.builtin"], "settings": { "foreground": "{{dark.amber}}", "fontStyle": "italic" } },
    { "scope": ["entity.name.function", "meta.function-call", "variable.function", "support.function"], "settings": { "foreground": "{{dark.blue}}" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.module"], "settings": { "foreground": "{{dark.cyan}}" } },
    { "scope": ["entity.other.attribute-name", "meta.decorator", "meta.annotation", "entity.name.label"], "settings": { "foreground": "{{dark.cyan}}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{dark.accent}}" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.definition.tag"], "settings": { "foreground": "{{dark.muted}}" } },
    { "scope": ["punctuation.section.embedded", "punctuation.definition.template-expression"], "settings": { "foreground": "{{dark.pink}}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{dark.accent}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{dark.blue}}", "fontStyle": "underline" } },
    { "scope": ["markup.raw", "markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "{{dark.green}}" } },
    { "scope": ["markup.list punctuation.definition.list", "punctuation.definition.list.begin"], "settings": { "foreground": "{{dark.pink}}" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "{{dark.muted}}", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{dark.green}}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{dark.rose}}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{dark.accent}}" } },
    { "scope": ["invalid"], "settings": { "foreground": "{{dark.rose}}" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "{{dark.amber}}", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "namespace": "{{dark.cyan}}",
    "parameter": "{{dark.textSoft}}",
    "property": "{{dark.textSoft}}",
    "enumMember": "{{dark.amber}}",
    "macro": "{{dark.amber}}",
    "*.defaultLibrary": { "fontStyle": "italic" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
