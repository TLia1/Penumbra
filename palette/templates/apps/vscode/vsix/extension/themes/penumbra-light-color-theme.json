  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{light.dim}}", "fontStyle": "italic" } },
    { "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "{{light.green}}" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "{{light.pink}}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "constant.character"], "settings": { "foreground": "{{light.amber}}" } },
    { "scope": ["support.constant"], "settings": { "foreground": "{{light.amber}}", "fontStyle": "italic" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "{{light.text}}" } },
    { "scope": ["variable.language"], "settings": { "foreground": "{{light.pink}}", "fontStyle": "italic" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "{{light.textSoft}}" } },
    { "scope": ["variable.other.member", "variable.other.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "{{light.textSoft}}" } },
    { "scope": ["keyword", "keyword.control", "storage.modifier", "storage.type"], "settings": { "foreground": "{{light.accent}}" } },
    { "scope": ["storage.type.function", "keyword.declaration.function"], "settings": { "foreground": "{{light.accent}}", "fontStyle": "italic" } },
    { "scope": ["keyword.control.import", "keyword.other.import", "keyword.control.include"], "settings": { "foreground": "{{light.pink}}" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "{{light.pink}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "{{light.amber}}" } },
    { "scope": ["storage.type.primitive", "support.type.primitive", "support.type.builtin"], "settings": { "foreground": "{{light.amber}}", "fontStyle": "italic" } },
    { "scope": ["entity.name.function", "meta.function-call", "variable.function", "support.function"], "settings": { "foreground": "{{light.blue}}" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.module"], "settings": { "foreground": "{{light.cyan}}" } },
    { "scope": ["entity.other.attribute-name", "meta.decorator", "meta.annotation", "entity.name.label"], "settings": { "foreground": "{{light.cyan}}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{light.accent}}" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.definition.tag"], "settings": { "foreground": "{{light.muted}}" } },
    { "scope": ["punctuation.section.embedded", "punctuation.definition.template-expression"], "settings": { "foreground": "{{light.pink}}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{light.accent}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{light.blue}}", "fontStyle": "underline" } },
    { "scope": ["markup.raw", "markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "{{light.green}}" } },
    { "scope": ["markup.list punctuation.definition.list", "punctuation.definition.list.begin"], "settings": { "foreground": "{{light.pink}}" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "{{light.muted}}", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{light.green}}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{light.rose}}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{light.accent}}" } },
    { "scope": ["invalid"], "settings": { "foreground": "{{light.rose}}" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "{{light.amber}}", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "namespace": "{{light.cyan}}",
    "parameter": "{{light.textSoft}}",
    "property": "{{light.textSoft}}",
    "enumMember": "{{light.amber}}",
    "macro": "{{light.amber}}",
    "*.defaultLibrary": { "fontStyle": "italic" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
