// PENUMBRA greeting. Generated by tools/build-palette.py from palette/templates/config/fastfetch/config.jsonc
// and palette/palette.toml; edit those.
{
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/penumbra-logo.png",
    "width": 26,
    "height": 13,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 4
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "{{violet}}",
      "title": "{{violetBright}}",
      "output": "{{text}}",
      "separator": "{{dim}}"
    },
    "key": {
      "width": 16
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "  ◈  P E N U M B R A  ·  a quieter orbit."
    },
    {
      "type": "custom",
      "outputColor": "{{mid}}",
      "format": "╭────────────────────────────────────────────────╮"
    },
    {
      "type": "host",
      "key": "  󰌢 Host",
      "keyColor": "{{cyan}}",
      "format": "{name}"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "{{violet}}"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "keyColor": "{{violetBright}}"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "{{green}}"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "keyColor": "{{cyan}}",
      "format": "{width}×{height} @ {refresh-rate} Hz"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "{{amber}}"
    },
    {
      "type": "wm",
      "key": "   WM",
      "keyColor": "{{violet}}"
    },
    {
      "type": "custom",
      "outputColor": "{{mid}}",
      "format": "╰────────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "title",
      "key": "  ",
      "keyColor": "{{cyan}}",
      "format": "{user-name} @ {host-name}"
    },
    {
      "type": "custom",
      "outputColor": "{{mid}}",
      "format": "╭────────────────────────────────────────────────╮"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "keyColor": "{{blue}}"
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU",
      "keyColor": "{{blue}}"
    },
    {
      "type": "gpu",
      "key": "   Driver",
      "keyColor": "{{violet}}",
      "format": "{driver}"
    },
    {
      "type": "memory",
      "key": "   Memory",
      "keyColor": "{{violetBright}}"
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk",
      "keyColor": "{{green}}",
      "folders": "/"
    },
    {
      "type": "uptime",
      "key": "  󰔟 Uptime",
      "keyColor": "{{rose}}"
    },
    {
      "type": "custom",
      "outputColor": "{{mid}}",
      "format": "╰────────────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
