[Unit]
Description=Penumbra lock fallback: swaylock when the shell can no longer come back while locked
# penumbra-shell.service starts this through OnFailure= once systemd gives up restarting it.

[Service]
Type=oneshot
# Only when the session was locked (the shell keeps that outside itself), and while the
# compositor is up.
ExecCondition=/bin/sh -c 'test -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" && grep -qx locked "$XDG_RUNTIME_DIR/penumbra-locked"'
# Clear the marker only after the fallback locker exits successfully on unlock.
ExecStart=%h/.local/bin/penumbra-idle fallback-lock
ExecStartPost=/usr/bin/rm -f %t/penumbra-locked
